# ============================================================
# FIAP AI Lab — Variáveis de ambiente
# Prompt Engineering & AI · 2º Semestre 2026
# ------------------------------------------------------------
# Copie para .env antes de subir o stack:
#   cp .env.example .env
#
# Toda porta aqui é a porta do SEU computador. Se alguma já
# estiver ocupada, troque só o número da esquerda — nada dentro
# dos containers muda.
# ============================================================

# ------------------------------------------------------------
# POSTGRES UNIFICADO (perfis: todos)
# ------------------------------------------------------------
# Um único servidor Postgres atende TODAS as stacks:
#   postgres   → fila NuQ do Firecrawl (precisa de pg_cron)
#   openwebui  → contas, chats e configurações do Open WebUI
#   mem0       → memórias vetoriais do mem0 (pgvector)
#   langfuse   → usuários, projetos, prompts e datasets do Langfuse
POSTGRES_HOST_PORT=5432
POSTGRES_USER=fiap
POSTGRES_PASSWORD=fiap2026
POSTGRES_DB=postgres
WEBUI_POSTGRES_DB=openwebui
MEM0_POSTGRES_DB=mem0
LANGFUSE_POSTGRES_DB=langfuse

# ------------------------------------------------------------
# OLLAMA — servidor de LLM (perfis: todos)
# ------------------------------------------------------------
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=24h

# Modelos baixados automaticamente no primeiro boot
CHAT_MODEL=qwen3.5:0.8b
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Modelos extras, separados por vírgula (opcional).
# Exemplo: EXTRA_MODELS=qwen3:8b,deepseek-r2
EXTRA_MODELS=

# Chave da Ollama Cloud API — só se for usar modelos remotos
# OLLAMA_API_KEY=

# Chave do endpoint OpenAI-compatible do Ollama.
# O Ollama local ignora o valor, mas os SDKs exigem algo preenchido.
OPENAI_API_KEY=ollama

# ------------------------------------------------------------
# OPEN WEBUI — interface de chat (perfis: todos)
# ------------------------------------------------------------
WEBUI_PORT=3000
WEBUI_NAME=FIAP AI Lab
ENABLE_SIGNUP=true

# TROQUE ESTE VALOR. Assina as sessões de login do Open WebUI.
# Gere uma chave nova com:  openssl rand -hex 32
WEBUI_SECRET_KEY=changeme_super_secret

# ------------------------------------------------------------
# PIPELINES — plugins do Open WebUI (perfis: todos menos minimum)
# ------------------------------------------------------------
# Carrega os .py de ./pipelines: filtro de memória (mem0) e o
# modelo "Firecrawl Web". Aparece no Open WebUI como um endpoint
# OpenAI-compatible.
PIPELINES_PORT=9099
PIPELINES_API_KEY=0p3n-w3bu!

# ------------------------------------------------------------
# CHROMADB — vector store (perfis: todos menos minimum)
# ------------------------------------------------------------
CHROMADB_PORT=8000

# ------------------------------------------------------------
# SEARXNG — metabuscador self-hosted (perfis: complete, search)
# ------------------------------------------------------------
SEARXNG_PORT=8080
SEARXNG_VERSION=latest
SEARXNG_LANGUAGE=pt-BR

# TROQUE ESTE VALOR. Gere com:  openssl rand -hex 32
SEARXNG_SECRET=troque-esta-chave-no-env

# Workers/threads do servidor. Aumente só em máquinas potentes.
SEARXNG_WORKERS=4
SEARXNG_THREADS=4

# Quantos resultados a busca web do Open WebUI envia ao modelo.
# Valores altos estouram o context window de modelos pequenos.
WEB_SEARCH_RESULT_COUNT=5

# ------------------------------------------------------------
# MEM0 — memória de longo prazo (perfis: complete, memory)
# ------------------------------------------------------------
MEM0_PORT=8100

# Modelo que EXTRAI os fatos da conversa. Precisa devolver JSON
# limpo: modelos com thinking ligado por padrão (Qwen3, DeepSeek-R)
# escrevem o raciocínio antes do JSON e quebram o parser do mem0.
MEM0_LLM_MODEL=llama3.2:1b

# Dimensão do vetor do modelo de embedding. Precisa bater com o
# EMBEDDING_MODEL — qwen3-embedding:0.6b gera 1024 dimensões.
# Errar aqui só aparece na hora de gravar a primeira memória.
MEM0_EMBEDDING_DIMS=1024

# Baixa MEM0_LLM_MODEL no Ollama no primeiro boot do serviço.
MEM0_AUTO_PULL=true
MEM0_COLLECTION=fiap_memories

# ------------------------------------------------------------
# FIRECRAWL — crawling e extração (perfis: complete, crawl)
# ------------------------------------------------------------
FIRECRAWL_PORT=3002

# Tag da IMAGEM (sem "v"). O Dockerfile do Postgres usa o mesmo
# número com "v" na frente para baixar o schema da fila NuQ —
# aplicação e schema precisam ser da mesma versão.
FIRECRAWL_VERSION=2.11.14

# Painel de administração do RabbitMQ (usuário/senha: guest/guest)
RABBITMQ_UI_PORT=15672

# Paralelismo. Os padrões oficiais (8 workers, 10 requests) derrubam
# uma máquina que também roda o Ollama em CPU.
FIRECRAWL_WORKERS=4
FIRECRAWL_CONCURRENCY=5
FIRECRAWL_MAX_JOBS=3
FIRECRAWL_BROWSERS=2
FIRECRAWL_BLOCK_MEDIA=true
FIRECRAWL_LOG_LEVEL=info

# Teto de recursos por container (oficial: 4.0/8g e 2.0/4g)
FIRECRAWL_API_CPUS=3.0
FIRECRAWL_API_MEM=4g
FIRECRAWL_PW_CPUS=2.0
FIRECRAWL_PW_MEM=2g

# O harness do Firecrawl sobe vários processos antes de abrir a porta.
FIRECRAWL_STARTUP_TIMEOUT_MS=120000

# ------------------------------------------------------------
# LANGFUSE SELF-HOSTED — observabilidade (perfil: langfuse)
# ------------------------------------------------------------
# Alternativa open source ao LangSmith self-hosted (que é add-on
# Enterprise pago). O core do Langfuse é MIT: roda self-hosted sem
# licença, sem chave e sem custo — que é a regra da disciplina.
# Este perfil NÃO faz parte do `complete` — suba somando os perfis:
#   docker compose --profile complete --profile langfuse up -d

# Porta da interface. 3000 já é do Open WebUI, por isso 3001.
LANGFUSE_PORT=3001

# Major da imagem oficial (langfuse/langfuse e langfuse-worker).
LANGFUSE_VERSION=4

# TROQUE OS TRÊS. Gere cada um com:  openssl rand -hex 32
#   SALT            → deriva o hash das API keys
#   ENCRYPTION_KEY  → cifra os segredos guardados no banco
#   NEXTAUTH_SECRET → assina os cookies de sessão
# Trocar depois do primeiro boot inutiliza o que já foi gravado.
LANGFUSE_SALT=troque-por-openssl-rand-hex-32
LANGFUSE_ENCRYPTION_KEY=troque-por-openssl-rand-hex-32
LANGFUSE_NEXTAUTH_SECRET=troque-por-openssl-rand-hex-32

# Bootstrap do primeiro boot: cria organização, projeto, usuário e o
# par de chaves de API sem precisar clicar na interface.
LANGFUSE_INIT_ORG_ID=fiap
LANGFUSE_INIT_ORG_NAME=FIAP
LANGFUSE_INIT_PROJECT_ID=prompt-engineering-2026
LANGFUSE_INIT_PROJECT_NAME=Prompt Engineering 2026
LANGFUSE_ADMIN_EMAIL=profjorge.gomes@fiap.com.br
LANGFUSE_ADMIN_NAME=Prof. Jorge Luiz Gomes
LANGFUSE_ADMIN_PASSWORD=troque-esta-senha

# Chaves que o SDK das aulas usa. O prefixo pk-lf-/sk-lf- é a
# convenção do Langfuse; o resto pode ser qualquer string única.
LANGFUSE_PUBLIC_KEY=pk-lf-troque-este-valor
LANGFUSE_SECRET_KEY=sk-lf-troque-este-valor

# ClickHouse — guarda traces, observações e scores (o Postgres fica
# com os dados operacionais e é o mesmo dos outros serviços)
LANGFUSE_CLICKHOUSE_VERSION=25.12
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=fiap2026

# Redis — filas BullMQ entre web e worker
LANGFUSE_REDIS_VERSION=7
LANGFUSE_REDIS_AUTH=fiap2026

# MinIO — object storage S3-compatible, OBRIGATÓRIO. Todo evento de
# ingestão vira blob antes de virar linha no ClickHouse.
# A imagem do Chainguard é a do compose oficial e traz o `mc` usado
# no healthcheck; trocar por minio/minio quebra esse teste.
LANGFUSE_MINIO_IMAGE=cgr.dev/chainguard/minio
LANGFUSE_MINIO_USER=minio
LANGFUSE_MINIO_PASSWORD=fiap2026minio
LANGFUSE_MINIO_PORT=9090
LANGFUSE_MINIO_CONSOLE_PORT=9091
LANGFUSE_S3_BUCKET=langfuse

# Host liberado para conexão de LLM. O Langfuse bloqueia hosts de
# rede privada por padrão, e `ollama` é um deles.
LANGFUSE_WHITELISTED_HOST=ollama
LANGFUSE_EXPERIMENTAL=false

# Tetos de memória. O ClickHouse é o que mais consome; baixe para 2g
# se a máquina tiver 16 GB e você rodar junto com o perfil complete.
LANGFUSE_CLICKHOUSE_MEM=4g
LANGFUSE_WEB_MEM=2g
LANGFUSE_WORKER_MEM=2g
LANGFUSE_MINIO_MEM=1g
