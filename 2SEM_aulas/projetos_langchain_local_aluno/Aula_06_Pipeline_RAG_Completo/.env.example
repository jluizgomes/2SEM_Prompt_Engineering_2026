# ============================================================
# FIAP · Prompt Engineering & AI — 2º Semestre 2026
# Arquivo de exemplo. Copie para .env:
#   cp .env.example .env
# ============================================================

# Backend padrão do semestre: Ollama Cloud (modelos remotos)
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=COLE_SUA_CHAVE_AQUI

# Modelo de chat padrão do semestre
OLLAMA_MODEL=gpt-oss:120b

# Modelo de embeddings (usado nas aulas de RAG/ChromaDB)
EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------
# Alternativa GRATUITA: Ollama LOCAL (FIAP AI Lab, Docker)
# Descomente as duas linhas abaixo e comente as de cima:
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=qwen3.5:0.8b
# ------------------------------------------------------------
