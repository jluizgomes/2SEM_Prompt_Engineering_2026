# ---------- Ollama ----------
OLLAMA_API_KEY=seu_token_ollama_cloud_aqui
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen3.5:0.8b

# Modelo de embedding — nomic-embed-text (obrigatório pelo CKP02)
EMBEDDING_MODEL=nomic-embed-text

# ---------- ChromaDB ----------
