# ---------- ChromaDB (local, proprio) ----------
CHROMADB_PERSIST_DIR=./chromadb_data

# ---------- RAG (documentos na pasta data/) ----------
RAG_DATA_DIR=./data

# ---------- Gradio ----------
GRADIO_PORT=7860
GRADIO_SHARE=true
