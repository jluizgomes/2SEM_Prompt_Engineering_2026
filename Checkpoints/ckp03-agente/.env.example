# 100% standalone — pipeline RAG proprio embutido

# ---------- Ollama ----------
OLLAMA_API_KEY=seu_token_ollama_cloud_aqui
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen3.5:0.8b

# ---------- Embedding (nomic-embed-text via Ollama) ----------
